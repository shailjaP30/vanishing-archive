---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

interface Props {
  entry: CollectionEntry<'cases'>;
}

const { entry } = Astro.props;
const { title, number, genre, status, difficulty, price, blurb, evidence, theme } = entry.data;
const { Content } = await render(entry);
const themeVars = `--accent:${theme.accent}; --accent-dim:${theme.accentDim}; --bg:${theme.bg}; --panel:${theme.panel}; --font-display:${theme.fontDisplay}; --font-body:${theme.fontBody};`;
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title} — The Vanishing Archive</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Special+Elite&family=IBM+Plex+Serif:ital,wght@0,400;0,500;0,600;1,400&family=Cormorant+Decorative&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <div class="case-page" style={themeVars}>
    <div class="case-hero">
      <div class="case-inner">
        <a href="/" class="back-link">&larr; Back to the archive</a>
        <p class="case-num">{number} — {genre.toUpperCase()}</p>
        <h1>{title}</h1>
        <div class="case-difficulty">
          {Array.from({ length: 5 }).map((_, i) => (
            <span class={`skull ${i < difficulty ? 'on' : ''}`}>&#9760;</span>
          ))}
        </div>
        <p class="case-blurb">{blurb}</p>
      </div>
    </div>

    <div class="case-section">
      <h2>What's in the file</h2>
      <ul class="evidence-list">
        {evidence.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="case-section">
      <Content />
    </div>

    <div class="buy-bar">
      <span class="price">{price}</span>
      <button class="buy-btn">Claim this case</button>
    </div>
  </div>
</body>
</html>

<style>
  body { margin: 0; }
  .case-page { background: var(--bg); min-height: 100vh; color: #e8e0cc; font-family: var(--font-body); }
  .case-hero { padding: 3.2rem 1.5rem 2.4rem; border-bottom: 1px solid rgba(255,255,255,.08); }
  .case-inner { max-width: 680px; margin: 0 auto; }
  .back-link { font-family: var(--font-display); font-size: .82rem; color: var(--accent); text-decoration: none; display: inline-block; margin-bottom: 1.6rem; }
  .case-num { color: var(--accent); font-family: var(--font-display); font-size: .9rem; }
  h1 { font-family: var(--font-display); font-weight: 400; line-height: 1.15; font-size: 2.1rem; margin: .5rem 0 .8rem; }
  .case-difficulty { display: flex; gap: .25rem; margin-bottom: 1rem; }
  .skull { color: #4a4437; }
  .skull.on { color: var(--accent); }
  .case-blurb { font-size: 1.05rem; line-height: 1.7; max-width: 56ch; }
  .case-section { max-width: 680px; margin: 0 auto; padding: 2rem 1.5rem; }
  .case-section h2 { font-family: var(--font-display); font-size: 1.1rem; font-weight: 400; color: var(--accent); margin-bottom: 1rem; }
  .evidence-list { list-style: none; margin: 0; padding: 0; display: grid; gap: .7rem; }
  .evidence-list li { border: 1px solid rgba(255,255,255,.1); background: var(--panel); padding: .85rem 1rem; border-radius: 2px; font-size: .95rem; line-height: 1.55; }
  .buy-bar { max-width: 680px; margin: 0 auto; padding: 1.6rem 1.5rem 3rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .price { font-family: var(--font-display); font-size: 1.3rem; }
  .buy-btn { font-family: var(--font-display); background: var(--accent); color: #fff; border: none; padding: .85rem 1.6rem; font-size: .95rem; cursor: pointer; border-radius: 2px; }
  .buy-btn:hover { background: var(--accent-dim); }
</style>